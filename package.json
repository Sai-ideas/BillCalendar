{
  "name": "billcalendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev:api": "node -e \"import('node:fs').then(fs => fs.mkdirSync('dist/client', { recursive: true }))\"",
    "dev": "concurrently -n api,client -c cyan,magenta \"npm run dev:api\" \"npm run dev:client\"",
    "dev:client": "vite --port 5173",
    "dev:api": "wrangler dev --env development --port 8787",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev --env development --port 8787",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "predb:migrate:local": "npm run predev:api",
    "db:migrate:local": "wrangler d1 migrations apply billcalendar-db --local --env development"
  },
  "dependencies": {
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.4",
    "lunar-javascript": "^1.7.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tailwindcss/vite": "^4.0.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.5",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8",
    "wrangler": "^4.2.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
